# cmake -DOUTPUT=... -DCOMPILER=... -DHEADERS=a;b;c -P WriteComputeAbi.cmake
set(text "${COMPILER}\n")
foreach(header IN LISTS HEADERS)
    file(SHA256 "${header}" digest)
    get_filename_component(name "${header}" NAME)
    string(APPEND text "${name} ${digest}\n")
endforeach()
string(SHA256 abi "${text}")
string(SUBSTRING "${abi}" 0 16 abi)
set(content "// Generated by cmake/WriteComputeAbi.cmake.\n#pragma once\n\nnamespace forevertas {\ninline constexpr char kComputeAbi[] = \"${abi}\";\n}\n")
file(WRITE "${OUTPUT}" "${content}")
